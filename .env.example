# The local Obsidian vault that the bridge reads and writes.
VAULT_PATH=E:\ACE\personal-knowledge-base

# Optional local bridge port.
PORT=8787

# OpenAI-compatible AI gateway. Keep actual secrets in .env.local only.
AI_BASE_URL=https://YOUR-RELAY/v1
AI_API_KEY=YOUR_RELAY_API_KEY
AI_MODEL=

# Required only while testing the phone against this local bridge over LAN.
AI_GATEWAY_TOKEN=replace-with-a-long-random-local-token

# Supabase authentication and encrypted-in-transit state synchronization.
# Use the Project URL and Publishable key (or legacy anon key). This key is
# intentionally exposed to the browser after RLS is enabled; never put the
# service_role key or the AI gateway key in browser code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
