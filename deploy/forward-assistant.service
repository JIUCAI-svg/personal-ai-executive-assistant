[Unit]
Description=Forward personal AI executive assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/forward-assistant/app
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=VAULT_PATH=/srv/forward-assistant/data/vault
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/forward-assistant

[Install]
WantedBy=multi-user.target
